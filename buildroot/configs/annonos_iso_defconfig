# AnnonOS x86_64 Live ISO Configuration (Buildroot, BIOS + UEFI)
BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y

BR2_TARGET_GENERIC_HOSTNAME="AnnonOS-Tactical"
BR2_TARGET_GENERIC_ISSUE="AnnonOS Sovereign Field Unit - Authorized Personnel Only"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_POST_BUILD_SCRIPT="../board/annonos-target/post-build.sh"

# Kernel (bzImage) and initramfs (rootfs.cpio.gz)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_LINUX_KERNEL_BZIMAGE=y
BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y
BR2_TARGET_ROOTFS_TAR=y

# Bootloader: GRUB2 for BIOS and UEFI
BR2_TARGET_GRUB2=y
BR2_TARGET_GRUB2_I386_PC=y
BR2_TARGET_GRUB2_X86_64_EFI=y

# Live ISO (rootfs.iso9660), booted from the initramfs
BR2_TARGET_ROOTFS_ISO9660=y
BR2_TARGET_ROOTFS_ISO9660_INITRD=y
BR2_TARGET_ROOTFS_ISO9660_BOOT_MENU="../board/annonos-target/grub.cfg"
BR2_TARGET_ROOTFS_ISO9660_HYBRID=y

BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON3_CRYPTOGRAPHY=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_IPTABLES=y
